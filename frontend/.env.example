# Copie este arquivo para ".env" (dev) ou ".env.production" (build de produção) e
# ajuste o valor. O ".env" real nunca é commitado.

# URL base da API do backend (don-abronni-backend-mongo). Sem essa variável definida
# no ambiente de build, o app usa http://localhost:3001/api como padrão — ótimo pra
# desenvolvimento local, mas quebra 100% das chamadas em qualquer build de produção
# feito fora da máquina de quem programou.
VITE_API_URL=http://localhost:3001/api

# Chave do Google Maps Embed (mapa da seção "Localização" da home). Diferente de
# uma chave de backend, chaves de Embed API são feitas pra ficar visíveis no
# HTML/JS público — não tem como "esconder" (o navegador do usuário precisa dela
# pra carregar o mapa). A proteção de verdade não é escondê-la, é restringi-la no
# Google Cloud Console: Credenciais > essa chave > "Restrições de aplicativo" >
# HTTP referrers > adicionar o(s) domínio(s) reais do site. Sem essa restrição,
# qualquer pessoa que veja essa chave (é trivial, está em texto puro no HTML) pode
# usá-la em outro site e consumir a cota/faturamento de vocês.
VITE_GOOGLE_MAPS_EMBED_KEY=coloque_aqui_a_chave_do_google_cloud_console
