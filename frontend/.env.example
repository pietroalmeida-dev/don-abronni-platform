# Copie este arquivo para ".env" (dev) ou ".env.production" (build de produção) e
# ajuste o valor. O ".env" real nunca é commitado.

# URL base da API do backend (don-abronni-backend-mongo). Sem essa variável definida
# no ambiente de build, o app usa http://localhost:3001/api como padrão — ótimo pra
# desenvolvimento local, mas quebra 100% das chamadas em qualquer build de produção
# feito fora da máquina de quem programou.
VITE_API_URL=http://localhost:3001/api

# O mapa da seção "Localização" usa o embed clássico do Google Maps
# (maps.google.com/maps?...&output=embed), que não exige chave de API nem conta no
# Google Cloud — por isso não há nenhuma variável de mapa aqui. Se um dia o projeto
# precisar de recursos avançados do Maps (rotas, autocomplete de endereço), aí sim
# valeria trocar pela Embed API oficial com chave restrita por domínio.
